Cell["\<\
The same result by Picard iteration for W'(t) = [A, W(t)], W(0) = B, at t = 1:\
\>", "Text",ExpressionUUID->"c59605a4-a6af-4c34-9df9-46bd82e4898f"],

Cell[CellGroupData[{

Cell["\<\
expad0[A_, B_] := Module[{t, picard},
  picard[W_] := B + Integrate[LieBracket[A, W], {t, 0, t}];
  FixedPoint[picard, B] /. t -> 1];
HallCoefficients[expad0[X + Y + LieBracket[X, Y], Y - X] - ExpAd[X + Y + \
LieBracket[X, Y], Y - X]]\
\>", "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"6546c6e7-2b89-43a4-b450-8bf3fac78a00"],

