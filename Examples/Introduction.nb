     RowBox[{"1", "+", "t"}], ")"}], " ", 
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""},
     "RowDefault"]}], "-", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", "s"}], ")"}], " ", 
    SuperscriptBox["t", "2"], " ", 
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
      TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
       "RowDefault"], "\"]\""},
     "RowDefault"]}], "+", 
