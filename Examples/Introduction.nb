Cell["\<\
After a new initialization, Lie series created before are no longer valid. \
Using them gives a message instead of a wrong result:\
\>", "Text",ExpressionUUID->"45857775-7f72-44f5-a504-6402193c67a8"],

Cell[CellGroupData[{

Cell["LieBracket[X, Y]", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"396f405f-396f-47d3-87ee-33c529551e80"],

Cell[BoxData[
 TemplateBox[{
  "LieSeries", "stale", 
   "\"A Lie series created before the last call to LieSeriesInitialize was \
used. It is not valid in the current basis.\"", 2, 31, 1, 
   27348532455756524704, "Local", "LieSeries`LieSeries"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{4.004495345520132*^9, 4.0046365858297443`*^9, 
  4.004643051119894*^9},
