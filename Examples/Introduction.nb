           "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""}, "RowDefault"], 
      "\"]\""},
     "RowDefault"]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", "[", "3", "]"}], "+", 
      RowBox[{"c", "[", "4", "]"}]}], ")"}], " ", 
