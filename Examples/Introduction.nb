Cell[CellGroupData[{

Cell["Basic operations", "Section",ExpressionUUID->"03028554-5adf-4786-825d-fb882c984f4f"],

Cell["\<\
Lie series can be added, multiplied by scalars and bracketed. LieBracket[A, \
B] (or A \[Diamond] B) gives [A, B] truncated at $MaxDegree.\
\>", "Text",ExpressionUUID->"6a4bc28c-f643-4b2e-802d-1ca1b6c3076e"],

Cell[CellGroupData[{

Cell["\<\
A = X + LieBracket[X, Y]/2 + LieBracket[LieBracket[LieBracket[X, Y], X - Y], \
X + LieBracket[X, Y]]\
\>", "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"1e7e72a5-668a-4e14-b2ae-9e45e9c1d437"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"X\"\>", "+", 
   FractionBox[
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""},
     "RowDefault"], "2"], "+", 
   TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
     TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
       TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
        "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"], "-", 
   TemplateBox[{"\"[\"", "\"Y\"", "\",\"", 
     TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
       TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
        "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"], "+", 
   TemplateBox[{"\"[\"", 
     TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, "RowDefault"],
      "\",\"", 
     TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
       TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
        "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"], "-", 
   TemplateBox[{"\"[\"", 
     TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, "RowDefault"],
      "\",\"", 
     TemplateBox[{"\"[\"", "\"Y\"", "\",\"", 
       TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
        "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"]}],
  LieSeries`LieSeries[1, {1, 0, 
    Rational[1, 2], 0, 0, 1, -1, 0, 0, 0, 0, 0, 1, -1}]]], "Output",
 CellChangeTimes->{4.004495304047266*^9, 4.0046364918794203`*^9, 
  4.004642980759713*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"5692bd58-09ab-4cd4-976c-cd957898aa93"]
}, Open  ]],

Cell["\<\
The internal form is a coefficient vector indexed by all the trees generated \
by the algorithm (Hall trees and auxiliary trees), together with a stamp \
identifying the basis:\
\>", "Text",ExpressionUUID->"494b13f5-7698-4696-88dc-d97b4fe2d11f"],

Cell[CellGroupData[{

Cell["InputForm[A]", "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"fc4c275a-cd7c-405c-910f-4f31f7f33cfa"],

Cell["LieSeries[1, {1, 0, 1/2, 0, 0, 1, -1, 0, 0, 0, 0, 0, 1, -1}]", "Output",
 CellChangeTimes->{4.004642986460188*^9},
 CellLabel->
  "Out[8]//InputForm=",ExpressionUUID->"55c8dc27-9388-4703-bd9f-7f326678a246"]
}, Open  ]],

Cell["\<\
Coefficients may depend on parameters; differentiation, integration, Expand, \
Coefficient, Collect, Simplify, etc. act on the coefficients.\
\>", "Text",ExpressionUUID->"ae674d5c-0b4e-4ffd-a0fa-efd2e21c75f4"],

Cell[CellGroupData[{

Cell["\<\
A = X + LieBracket[(1 + t) X, Y]/2 + LieBracket[LieBracket[(s - 2) X, t Y], t \
X - Y]\
\>", "Input",
 CellLabel->"In[9]:=",ExpressionUUID->"67d94e1f-2194-4199-b53e-06b74690e0d5"],

