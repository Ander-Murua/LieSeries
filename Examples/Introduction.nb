Cell["\<\
Substitutions (LieSeriesSubstitution, BCH with matrices, ...) use the full \
element of L(A,B), so they are exact even for objects that do not satisfy \
[b,[b,[b,a]]] = 0.\
\>", "Text",ExpressionUUID->"a5069463-4a21-45b1-bd4b-7d50db28d0fc"],

Cell["\<\
The basis of L(A,B)/I comes from the Hall basis HallOrder -> \"PDegree\" of \
the free Lie algebra, built from the P-degree, the polynomial degree in the \
momenta: 2 for A (the first generator), 0 for B, and max(p1 + p2 - 1, 0) for \
a bracket. Trees are ordered by P-degree, then by index. The Hall elements in \
which no subtree is a bracket of two elements of P-degree 0 form a basis of \
L(A,B)/I; the others span I. Working in the free Lie algebra with this basis, \
ClassicalMechanicsBasisElements and ClassicalMechanicsCoefficients show which \
part of an element survives in the quotient:\
\>", "Text",ExpressionUUID->"d60e7bbc-4a4a-4b4a-880f-8809b7b0e58d"],

Cell[CellGroupData[{

Cell["\<\
LieSeriesInitialize[{\"A\", \"B\"}, 6, HallOrder -> \"PDegree\"];
A = LieSeries[\"A\"]; B = LieSeries[\"B\"];
TableForm[Table[{n, HallDimension[n], \
Length[ClassicalMechanicsBasisElements[{n}]]}, {n, 1, 6}],
  TableHeadings -> {None, {\"degree\", \"dim L(A,B)\", \"dim L(A,B)/I\"}}]\
\>", "Input",
 CellLabel->"In[66]:=",ExpressionUUID->"849c05ce-38fd-4083-88eb-ef7086f44fee"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"degree\"\>",
       HoldForm], 
      TagBox["\<\"dim L(A,B)\"\>",
       HoldForm], 
      TagBox["\<\"dim L(A,B)/I\"\>",
       HoldForm]},
     {"1", "2", "2"},
     {"2", "1", "1"},
     {"3", "2", "2"},
     {"4", "3", "2"},
     {"5", "6", "4"},
     {"6", "9", "5"}
    },
    GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
    GridBoxDividers->{
     "Columns" -> {{False}}, "Rows" -> {False, True, {False}, False}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[2.0999999999999996`]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"degree", "dim L(A,B)", "dim L(A,B)/I"}}]]]], "Output",
 CellChangeTimes->{4.004495659808779*^9, 4.004636671937834*^9, 
  4.004643111665659*^9},
 CellLabel->
  "Out[68]//TableForm=",ExpressionUUID->"907fb2a8-fd59-4b93-afe4-\
0aee08aaa6aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
x5 = LieBracket[A, LieBracket[B, LieBracket[B, LieBracket[B, A]]]];
{HallCoefficients[x5, {5}], ClassicalMechanicsCoefficients[x5, {5}]}\
\>", "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"85b84746-1e59-4a85-83f0-b9b495b0bc77"],

