Cell["\<\
FormatMaxDegree (or later the variable $FormatMaxDegree) controls how many \
degrees are displayed; \[Ellipsis] indicates hidden nonzero terms.\
\>", "Text",ExpressionUUID->"6cb230ef-5583-4f52-afbd-99dfad083c5d"],

Cell[CellGroupData[{

Cell["\<\
$FormatMaxDegree = 3;
$BCHLieSeries\
\>", "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"f1d05128-a4a0-44ce-8fdd-4b6a86abacb6"],

