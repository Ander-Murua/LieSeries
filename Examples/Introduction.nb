        TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
         "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
     "RowDefault"]}], "+", 
   RowBox[{
    RowBox[{"c", "[", "4", "]"}], " ", 
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
      TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
        TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
          
