          TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
           "RowDefault"], "\"]\""}, "RowDefault"]}]}], "\" + \[Ellipsis]\""},
   "RowDefault"],
  LieSeries`LieSeries[
  2, SparseArray[
   Automatic, {14}, 0, {
    1, {{0, 14}, {{9}, {10}, {11}, {12}, {13}, {14}, {1}, {2}, {3}, {4}, {
      5}, {6}, {7}, {8}}}, {
     Rational[-1, 720], Rational[1, 360], Rational[1, 120], Rational[1, 180], 
      Rational[1, 180], Rational[-1, 720], 1, 1, Rational[1, 2], Rational[
      1, 12], Rational[1, 12], 0, Rational[1, 24], 0}}]]]], "Output",
 CellChangeTimes->{4.0044953677739058`*^9, 4.0046365916581287`*^9, 
  4.0046430557767553`*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"7534d0d5-5dc1-4224-9100-2ec0b1118fea"]
}, Open  ]],

