Cell[CellGroupData[{

Cell["The Thompson problem", "Section",ExpressionUUID->"7d5345a5-4246-418d-a87b-bcf834d4a3f0"],

Cell["\<\
R. C. Thompson showed that there are Lie series A, B such that log(exp(X) \
exp(Y)) = exp(ad_A) X + exp(ad_B) Y. We look for them as generic Lie series, \
normalized so that A has no term in X and B no term in Y:\
\>", "Text",ExpressionUUID->"e5186498-d41a-44bc-a88a-b8f2b4c24139"],

Cell["\<\
Clear[a, b];
LieSeriesInitialize[{\"X\", \"Y\"}, 5];
X = LieSeries[\"X\"]; Y = LieSeries[\"Y\"];
A = GenericLieSeries[a, $MaxDegree - 1] /. a[1] -> 0;
B = GenericLieSeries[b, $MaxDegree - 1] /. b[2] -> 0;\
\>", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"d3a14018-d0a4-4f3b-96e4-34d30038d77b"],

Cell["\<\
We look for a solution with B obtained from A by the substitution X \[Rule] \
-Y, Y \[Rule] -X, and solve the equations up to degree 5:\
\>", "Text",ExpressionUUID->"cfc9adef-273d-4dc9-9bbb-b3a66719a8dd"],

Cell[CellGroupData[{

Cell["\<\
B = LieSeriesSubstitution[A, {\"X\" -> -Y, \"Y\" -> -X}];
eqs = ZeroLieSeriesEquations[$BCHLieSeries - ExpAd[A, X] - ExpAd[B, Y]];
sol = Solve[eqs]\
\>", "Input",
 CellLabel->"In[54]:=",ExpressionUUID->"83141152-f535-4d08-8471-be22e02847c9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "2", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", "4"]}]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "3", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["5", "96"]}]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "4", "]"}], "\[Rule]", 
     FractionBox["1", "384"]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "5", "]"}], "\[Rule]", 
     FractionBox["11", "768"]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "6", "]"}], "\[Rule]", 
     FractionBox["143", "92160"]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "7", "]"}], "\[Rule]", 
     FractionBox["283", "92160"]}], ",", 
    RowBox[{
     RowBox[{"a", "[", "8", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox["11", "23040"]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{4.004495537036334*^9, 4.004636647322866*^9, 
  4.004643087267982*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"aa8a3018-0901-478a-bcb5-224d70280818"]
}, Open  ]],

