Cell[CellGroupData[{

Cell["Substitution", "Section",ExpressionUUID->"41c8945f-3f48-439e-bfa0-5e24fd25c30c"],

Cell["\<\
LieSeriesSubstitution replaces the generators by Lie series, matrices, or any \
objects with a bracket.\
\>", "Text",ExpressionUUID->"75661efd-8649-49a6-bf26-dc998ab780ef"],

Cell[CellGroupData[{

Cell["\<\
LieSeriesSubstitution[GenericLieSeries[c, 3], {\"X\" -> X + Y + LieBracket[X, \
Y], \"Y\" -> LieBracket[X, LieBracket[X, Y]]}]\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"f05446b2-95b1-4cec-848f-fb4187a05816"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{
    RowBox[{"c", "[", "1", "]"}], " ", "\<\"X\"\>"}], "+", 
   RowBox[{
    RowBox[{"c", "[", "1", "]"}], " ", "\<\"Y\"\>"}], "+", 
   RowBox[{
    RowBox[{"c", "[", "1", "]"}], " ", 
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""},
     "RowDefault"]}], "+", 
