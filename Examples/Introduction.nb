Cell["\<\
With the option LieBracketFunction one can use another bracket, e.g. that of \
vector fields f(x)\[PartialD]/\[PartialD]x on the line, represented by the \
function f:\
\>", "Text",ExpressionUUID->"4bf1424b-5d9d-472c-b880-75ce37ac5c7c"],

Cell[CellGroupData[{

Cell["\<\
vf[f_, g_] := f D[g, x] - g D[f, x];
BCH[x^2, 1/x, LieBracketFunction -> vf] // Simplify\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"6b2780f1-a9dd-4e03-8eac-65678b87cd98"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "80"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "100"}], "-", 
    FractionBox["1", 
     SuperscriptBox["x", "6"]], "+", 
    FractionBox["4", 
     SuperscriptBox["x", "3"]], "+", 
    FractionBox["20", 
     SuperscriptBox["x", "2"]], "+", 
    FractionBox["40", "x"], "+", 
    RowBox[{"40", " ", "x"}], "+", 
    RowBox[{"80", " ", 
     SuperscriptBox["x", "2"]}]}], ")"}]}]], "Output",
 CellChangeTimes->{4.004495329420557*^9, 4.0046365729248753`*^9, 
  4.0046430367256002`*^9},
 CellLabel->"Out[26]=",ExpressionUUID->"6b03592b-6fb4-426a-8816-b1b1c211e3b4"]
}, Open  ]],

Cell["\<\
With symbolic arguments the brackets stay unevaluated, which gives the \
expansion in nested brackets:\
\>", "Text",ExpressionUUID->"4d2f8673-21e6-40cb-8ff4-d4122b5dbf7d"],

Cell[CellGroupData[{

Cell["BCH[\"P\", \"Q\", 4]", "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"e7cc376d-b717-454d-81b4-60bc5b421d9f"],

Cell[BoxData[
 RowBox[{"\<\"P\"\>", "+", "\<\"Q\"\>", "+", 
  FractionBox[
   TemplateBox[{"\"[\"", "\"P\"", "\",\"", "\"Q\"", "\"]\""},
    "RowDefault"], "2"], "+", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   TemplateBox[{"\"[\"", "\"P\"", "\",\"", 
     TemplateBox[{"\"[\"", "\"P\"", "\",\"", "\"Q\"", "\"]\""}, "RowDefault"],
      "\"]\""},
    "RowDefault"]}], "-", 
  RowBox[{
   FractionBox["1", "12"], " ", 
   TemplateBox[{"\"[\"", "\"Q\"", "\",\"", 
     TemplateBox[{"\"[\"", "\"P\"", "\",\"", "\"Q\"", "\"]\""}, "RowDefault"],
      "\"]\""},
    "RowDefault"]}], "-", 
  RowBox[{
   FractionBox["1", "24"], " ", 
   TemplateBox[{"\"[\"", "\"Q\"", "\",\"", 
     TemplateBox[{"\"[\"", "\"P\"", "\",\"", 
       TemplateBox[{"\"[\"", "\"P\"", "\",\"", "\"Q\"", "\"]\""}, 
        "RowDefault"], "\"]\""}, "RowDefault"], "\"]\""},
    "RowDefault"]}]}]], "Output",
 CellChangeTimes->{4.0044953313194838`*^9, 4.0046365754395933`*^9, 
  4.004643040292584*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"6284e623-10eb-425d-a2bf-5cc0ff1a953c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Choice of the Hall basis", "Section",ExpressionUUID->"2049d9e6-b825-4db5-a06f-fb2b138c92d6"],

Cell["The built-in Hall orders are", "Text",ExpressionUUID->"ece78355-5a1f-4251-821c-00dae0c9ca6c"],

Cell[CellGroupData[{

Cell["HallOrders[]", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"33cb664f-8496-4660-bcea-0ef375c3e34f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Standard\"\>", 
    "\[Rule]", "\<\"Trees compared by their construction index: first by \
degree, then in order of generation.\"\>"}], ",", 
   RowBox[{"\<\"Lyndon\"\>", 
    "\[Rule]", "\<\"Lyndon basis: trees compared through the lexicographic \
order of their foliage words.\"\>"}], ",", 
   RowBox[{"\<\"Tall\"\>", 
    "\[Rule]", "\<\"Trees compared by tall degree t (t = 1 for generators, t \
= max(t(left), t(right)+1)), then by index.\"\>"}], ",", 
   RowBox[{"\<\"Left\"\>", 
    "\[Rule]", "\<\"Trees compared by degree, then by the index of the left \
subtree, then by index.\"\>"}], ",", 
   RowBox[{"\<\"Right\"\>", 
    "\[Rule]", "\<\"Trees compared by degree, then by the index of the right \
subtree, then by index.\"\>"}], ",", 
   RowBox[{"\<\"PDegree\"\>", 
    "\[Rule]", "\<\"Trees compared by P-degree (2 for the first generator, 0 \
for the second, max(p1 + p2 - 1, 0) for a bracket), then by index (McLachlan \
& Murua 2019). A subset of this basis is a basis of the Lie algebra of \
classical mechanics; see LieAlgebra and \
ClassicalMechanicsBasisElements.\"\>"}]}], "\[RightAssociation]"}]], "Output",\

 CellChangeTimes->{4.004495334311967*^9, 4.004636580913681*^9, 
  4.004643044508903*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"62863ff2-72e8-41f2-b292-98b4743d028b"]
}, Open  ]],

Cell["\<\
For instance, the BCH series in the Lyndon basis, with brackets read in the \
natural direction:\
\>", "Text",ExpressionUUID->"fff4db37-7b48-4fe2-bc07-4bc93a93f6ed"],

Cell[CellGroupData[{

Cell["\<\
LieSeriesInitialize[{\"X\", \"Y\"}, 5, HallOrder -> \"Lyndon\", Reversed -> \
False];
NonZeroHallCoefficients[$BCHLieSeries]\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"2e14d411-3552-4716-9360-2e3a7f64b1d2"],

