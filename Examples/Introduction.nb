    ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", "0"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.004495515282505*^9, 4.004636639166436*^9, 
  4.0046430778664093`*^9},
 CellLabel->"Out[47]=",ExpressionUUID->"2b860b94-89b4-4264-9e96-666a1c606013"]
}, Open  ]]
