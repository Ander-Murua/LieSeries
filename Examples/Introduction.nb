     TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, "RowDefault"],
      "\"]\""},
    "RowDefault"], ",", 
   TemplateBox[{"\"[\"", "\"Y\"", "\",\"", 
