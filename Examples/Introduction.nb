 InterpretationBox[
  TemplateBox[{
    RowBox[{"\"X\"", "+", "\"Y\"", "+", 
      FractionBox[
       TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
        "RowDefault"], "2"], "+", 
      RowBox[{
        FractionBox["1", "12"], " ", 
        TemplateBox[{"\"[\"", 
          
          TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
           "RowDefault"], "\",\"", "\"Y\"", "\"]\""}, "RowDefault"]}], "+", 
      RowBox[{
        FractionBox["1", "12"], " ", 
