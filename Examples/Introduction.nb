Notebook[{

Cell[CellGroupData[{
Cell["LieSeries: a guided tour", "Title",ExpressionUUID->"be634697-1aac-408b-9dcd-0816f9ed7dbc"],

Cell["\<\
This notebook introduces the LieSeries package: Lie series in the free Lie \
algebra on two generators, expressed in generalized Hall bases. Evaluate the \
cells in order.\
\>", "Text",ExpressionUUID->"fcb9f438-0376-439f-aa99-cb48ef522d11"],

Cell[CellGroupData[{

Cell["Loading and initialization", "Section",ExpressionUUID->"5486cf3b-a43e-4502-b84f-c7a7c3a9495e"],

Cell["\<\
Load the package. If the paclet is not installed, register its folder with \
PacletDirectoryLoad first, or load the file Kernel/LieSeries.wl with Get.\
\>", "Text",ExpressionUUID->"94b7d4bd-e0bd-489d-ba18-c7224d592c3d"],

Cell["\<\
PacletDirectoryLoad[ParentDirectory[NotebookDirectory[]]]; 
Needs[\"LieSeries`\"]\
\>", "Input",
 CellChangeTimes->{{4.004495287725169*^9, 4.004495292957358*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"67773095-a2f6-42bc-b7ac-88b443f9d808"],

Cell["\<\
LieSeriesInitialize builds the Hall basis up to a given degree. All Lie \
series are truncated at that degree.\
\>", "Text",ExpressionUUID->"63bf47a8-573b-43d5-a41d-37e4dec72d0d"],

Cell["\<\
LieSeriesInitialize[{\"X\", \"Y\"}, 5];
X = LieSeries[\"X\"]; Y = LieSeries[\"Y\"];\
\>", "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"542844bc-6065-415c-808d-e0fc52adc9f4"],

Cell[CellGroupData[{

Cell["LieSeriesBasisInfo[]", "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"6c1e419e-10de-4a68-8a48-112ff485b814"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Generators\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"X\"\>", ",", "\<\"Y\"\>"}], "}"}]}], ",", 
   RowBox[{"\<\"MaxDegree\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"LieAlgebra\"\>", "\[Rule]", "\<\"Free\"\>"}], ",", 
   RowBox[{"\<\"HallOrder\"\>", "\[Rule]", "\<\"Standard\"\>"}], ",", 
   RowBox[{"\<\"Reversed\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Dimensions\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"2", ",", "1", ",", "2", ",", "3", ",", "6"}], "}"}]}], ",", 
   RowBox[{"\<\"HallElements\"\>", "\[Rule]", "14"}], ",", 
   RowBox[{"\<\"BasisStamp\"\>", "\[Rule]", "1"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.004495298545899*^9, 4.004636488250248*^9, 
  4.0046429752783747`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"42a104a7-4e6b-4c8a-9a4c-812d4e2b38a6"]
}, Open  ]],

