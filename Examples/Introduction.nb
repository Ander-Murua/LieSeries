       "RowDefault"], "\"]\""},
     "RowDefault"]}]}],
  LieSeries`LieSeries[
  1, {1, 0, 
    Rational[1, 2] (
     1 + $CellContext`t), -(-2 + $CellContext`s) $CellContext`t^2, (-2 + \
$CellContext`s) $CellContext`t, 0, 0, 0, 0, 0, 0, 0, 0, 0}]]], "Output",
 CellChangeTimes->{4.004495308267274*^9, 4.0046364974320087`*^9, 
  4.004642999930228*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"99a19d53-9ddb-42fe-8e80-b0906cc0e56f"]
}, Open  ]],

