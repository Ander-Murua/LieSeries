    RowBox[{"c", "[", "2", "]"}], " ", 
    TemplateBox[{"\"[\"", "\"X\"", "\",\"", 
      TemplateBox[{"\"[\"", "\"X\"", "\",\"", "\"Y\"", "\"]\""}, 
       "RowDefault"], "\"]\""},
     "RowDefault"]}], "+", 
   RowBox[{
    RowBox[{"c", "[", "3", "]"}], " ", 
