     RowBox[{"-", "1"}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0044956653425903`*^9, 4.004636674349328*^9, 
  4.004643114763111*^9},
 CellLabel->"Out[70]=",ExpressionUUID->"d47bcf1f-ce39-4152-9ad7-a61012d60b42"]
}, Open  ]]
